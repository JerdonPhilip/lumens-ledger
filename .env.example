# Lumens Ledger environment configuration
# Copy this file to .env and adjust as needed.

# Port for the local HTTP server (bound to 127.0.0.1 only)
LEDGER_PORT=3000

# Custom data directory for the SQLite database (default: %APPDATA%/Lumens Ledger)
# LEDGER_DATA_DIR=

# Business timezone (IANA name)
LEDGER_TIMEZONE=Asia/Manila

# Default currency
LEDGER_CURRENCY=PHP

# Default currency symbol
LEDGER_CURRENCY_SYMBOL=₱

# VAT rate as a decimal (e.g. 0.12 for 12%)
LEDGER_VAT_RATE=0.12

# Default senior citizen / PWD discount rate as a decimal (e.g. 0.20 for 20%)
LEDGER_DISCOUNT_RATE=0.20

# Invoice number settings
LEDGER_INVOICE_PREFIX=INV
LEDGER_INVOICE_START=1
LEDGER_INVOICE_PADDING=6